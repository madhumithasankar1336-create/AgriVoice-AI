# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GNANI_API_KEY: Optional/configured key for Gnani AI (Vachana) Speech-to-Text & Text-to-Speech API.
# If not supplied, AgriVoice AI gracefully cascades to Gemini Multimodal Audio Transcription and Gemini TTS/Web Speech API.
GNANI_API_KEY="MY_GNANI_API_KEY"

# MONGODB_URI: Optional MongoDB connection string for cloud/remote chat history storage.
# If not connected, AgriVoice AI seamlessly uses in-memory & browser persistent local-storage fallback.
MONGODB_URI="mongodb://localhost:27017/agrivoice"

# PORT: Server port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

